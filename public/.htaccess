Options -Indexes

# API front controller
RewriteEngine On
RewriteRule ^api/v1(/.*)?$ api/index.php [L,QSA]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Public 3D viewer may be embedded on the provincial site; admin may not.
    <If "%{REQUEST_URI} =~ m#^/admin#">
        Header always set X-Frame-Options "DENY"
        Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    </If>
</IfModule>

# Data snapshot fallback and assets: short cache
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/json "access plus 1 minute"
</IfModule>
