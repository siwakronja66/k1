DB_NAME=ssjmuk3d
DB_USER=ssjmuk3d
DB_PASS=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password
WEB_PORT=8090
# 1 behind HTTPS (production). 0 only for local http://localhost testing.
COOKIE_SECURE=1
# Reverse proxy IP(s) whose X-Forwarded-For is trusted for rate limiting / audit IP. Empty = no proxy.
TRUSTED_PROXIES=
# Optional: POST a JSON summary of admin changes (n8n / LINE bridge). HMAC-SHA256 in X-Signature if SECRET set.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
# Comma list of audit actions to send. Empty = bookings + department/room changes.
NOTIFY_ACTIONS=
